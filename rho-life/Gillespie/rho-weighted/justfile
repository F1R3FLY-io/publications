# rho-weighted — a simulator for weighted graph-structured lambda theories.
# Requires only a Rust toolchain (1.75+). No system dependencies, no protoc,
# no network access at build time: the crate has no dependencies at all.

default: check

# Everything CI runs.
check: fmt-check build test test-quantum

build:
    cargo build --all-targets
    cargo build --all-targets --features quantum

# The classical suites (~4s after the first compile).
test:
    cargo test

# Adds the complex codomain (~8s; the first run recompiles for the feature).
test-quantum:
    cargo test --features quantum

fmt:
    cargo fmt --all

fmt-check:
    cargo fmt --all -- --check

lint:
    cargo clippy --all-targets --features quantum -- -D warnings

doc:
    cargo doc --no-deps --features quantum --open

# Print the numbers behind the note's §7.2, §7.5 and Remark 27.
verify:
    cargo run --release --features quantum --example verify-claims

# Emit graphs for one of: two-state | birth-death | rnn
sim MODEL="birth-death" OUT="out":
    cargo run --release --bin rho-sim -- {{MODEL}} {{OUT}}
    @echo "wrote {{OUT}}/{{MODEL}}.{dot,json} and {{OUT}}/{{MODEL}}-generator.csv"

clean:
    cargo clean
    rm -rf out
