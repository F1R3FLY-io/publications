// ===========================================================================
// Knots as rholang processes -- F1R3FLY.io working code
// Target: f1r3node-rust rholang-cli
//
// Crossing gate (four ports oi,oo,ui,uo; private latch l):
//   over strand : receive on oi, forward on oo, PRODUCE the latch l
//   under strand: JOIN on (ui, l) with '&', forward on uo, REINSTATE the gate
// Chirality == which strand produces l (over) vs. joins on it (under).
//
// RECURSION, NOT PERSISTENT RECEIPTS.  Every receipt below is LINEAR ('<-').
// The gate body is therefore a one-shot cell; what makes a crossing standing
// apparatus is that the cell reinstates itself.  The reinstatement sits in
// the under-half's continuation, and that placement is forced: the under-join
// can fire only after the over-half produced the latch, so its firing is the
// unique witness that one COMPLETE crossing event -- one over-passage and the
// under-passage it enabled -- has occurred.  Reinstating there releases
// exactly one copy per event (both continuations would double the copies each
// event; the over-half alone would arm a fresh over-receive while the old
// under-half is still outstanding).  It needs no guard and no extra channel.
//
// MATCHED LATCH.  Because 'new l' runs afresh on each instantiation, the
// latch an over-passage produces is consumed by the under-passage of the SAME
// copy: over-enables-under is a matching, not a count.  (Making both receipts
// persistent instead would share one latch channel across all passages, which
// counts but does not pair.)  A consequence: between an over-firing and the
// matching under-firing there is no receiver on oi at all, so a second
// over-signal simply waits -- structurally, not by any test.
//
// A DT traversal makes every arc a single-producer / single-consumer
// channel, so the arcs ARE the wires: no forwarder processes.
// "Current" is one message per arc.  It is CONSERVED rather than spent: arc
// tokens are neither created nor destroyed, latches are created and destroyed
// in matched pairs, exactly one copy of each gate is live at any time, and
// once every half-gate has fired once the marking is back where it started.
// A period is 2n primary rendezvous (n over-receives + n under-joins).
//
// NB in the calculus, unfolding a definition is an EQUATION and costs
// nothing.  In this interpreter 'contract' is a persistent receive on the
// definition channel, so each reinstatement is a real comm.  It draws on the
// stack located at the definition channel, not at any crossing, so the signed
// ledger (= 2*writhe) is unaffected; only the unsigned count reads 3n per
// period here against 2n in the calculus.
//
// NB on interpreter limits (rholang/README.md): no 0-arity send/receive
// (we always carry Nil), no guarded receive patterns, match patterns are
// not pre-evaluated (we never put arithmetic in a pattern).
// ===========================================================================


// ---------------------------------------------------------------------------
// Part 1.  The trefoil 3_1, DT code [4,6,2].  Runnable.
//
// passes 1..6, arc a_k = pass k -> pass (k+1 mod 6).  pass p: in a_{p-1}, out a_p.
// alternating => odd pass is OVER at every crossing (all-positive DT).
//   crossing 1 {odd 1, even 4}:  over a6->a1, under a3->a4
//   crossing 2 {odd 3, even 6}:  over a2->a3, under a5->a6
//   crossing 3 {odd 5, even 2}:  over a4->a5, under a1->a2
// ---------------------------------------------------------------------------
new Gate, a1, a2, a3, a4, a5, a6, stdout(`rho:io:stdout`) in {

  contract Gate(oi, oo, ui, uo) = {
    new l in {
        for (s <- oi)          { oo!(*s) | l!(Nil) }
      | for (s <- ui & _ <- l) { uo!(*s) | Gate!(*oi, *oo, *ui, *uo) }
    }
  }
  |
  Gate!(*a6, *a1, *a3, *a4)      // crossing 1
  |
  Gate!(*a2, *a3, *a5, *a6)      // crossing 2
  |
  Gate!(*a4, *a5, *a1, *a2)      // crossing 3
  |
  // current: one token per arc.  Conserved; the orbit has period 6.
  a1!(Nil) | a2!(Nil) | a3!(Nil) | a4!(Nil) | a5!(Nil) | a6!(Nil)
  |
  stdout!("trefoil encoding running")
}


// ===========================================================================
// Part 2.  Parametric builder: DT code -> knot process.
//
// DTtoKnot(dt, ret): dt is a list of signed even labels (one per crossing).
// Builds the whole network from a fresh unforgeable token `knot`; arc k is
// the reflected name @[*knot, k].  Returns *knot on ret so a caller can
// seed / observe the boundary if desired.
//
// Convention: dt_i > 0  =>  the ODD-labelled pass is the OVER strand.
// (Flip the (over,under) assignment below for the opposite convention.)
// ===========================================================================
new DTtoKnot, Gate, length in {

  // the crossing gate, once, for all crossings of all knots built here
  contract Gate(oi, oo, ui, uo) = {
    new l in {
        for (s <- oi)          { oo!(*s) | l!(Nil) }
      | for (s <- ui & _ <- l) { uo!(*s) | Gate!(*oi, *oo, *ui, *uo) }
    }
  } |

  // length of a list
  contract length(@xs, ret) = {
    match xs {
      []        => ret!(0)
      [_ ...t]  => { new r in { length!(t, *r) | for (@m <- r) { ret!(m + 1) } } }
    }
  } |

  contract DTtoKnot(@dt, ret) = {
    new knot, gates, inject, lenCh in {
      length!(dt, *lenCh) |
      for (@len <- lenCh) {
        // N = 2n arcs
        new go in {
          // ---- instantiate one Gate per crossing ----
          // gates(remaining, i, N): i is 1-based crossing index (odd label = 2i-1)
          contract gates(@rem, @i, @nn) = {
            match rem {
              []       => Nil
              [d ...t] => {
                // even label and over/under choice
                new eCh in {
                  ( if (d < 0) { eCh!(0 - d) } else { eCh!(d) } ) |
                  for (@e <- eCh) {
                    new pick in {
                      // pick!(overPass, underPass)
                      ( if (d > 0) { pick!(2 * i - 1, e) } else { pick!(e, 2 * i - 1) } ) |
                      for (@over, @under <- pick) {
                        new oiCh, uiCh in {
                          // in-arc(p) = N if p==1 else p-1 ; out-arc(p) = p
                          ( if (over  == 1) { oiCh!(nn) } else { oiCh!(over  - 1) } ) |
                          ( if (under == 1) { uiCh!(nn) } else { uiCh!(under - 1) } ) |
                          for (@oi <- oiCh & @ui <- uiCh) {
                            Gate!( *@[*knot, oi],    *@[*knot, over],
                                   *@[*knot, ui],    *@[*knot, under] )
                          }
                        }
                      }
                    }
                  }
                } |
                gates!(t, i + 1, nn)
              }
            }
          } |
          // ---- inject current on every arc 1..N ----
          contract inject(@k, @nn) = {
            if (k <= nn) { @[*knot, k]!(Nil) | inject!(k + 1, nn) } else { Nil }
          } |
          gates!(dt, 1, 2 * len) |
          inject!(1, 2 * len) |
          ret!(*knot)
        }
      }
    }
  } |

  // Example: build the trefoil and the figure-eight
  new r1, r2 in {
    DTtoKnot!([4, 6, 2], *r1) |
    DTtoKnot!([4, 6, 8, 2], *r2) |
    for (_ <- r1) { Nil } |
    for (_ <- r2) { Nil }
  }
}


// ===========================================================================
// Part 3.  The Perko pair.  Perko A = 10_161, DT [4,12,-16,14,-18,2,8,-20,-10,-6]
// (KnotInfo / Wikipedia).  Perko A and Perko B (formerly 10_162) are the SAME
// knot with DIFFERENT writhes -- the classical refutation of Little's
// writhe-invariance claim.  Our encoding gives them weakly-bisimilar boundary
// forwarders (same knot) but SIGNED cost ledgers differing by 2*(w_A - w_B).
// The UNSIGNED count does not separate them: both are reduced 10-crossing
// diagrams, so both spend 20 primary rendezvous per period.
// Generated by dt_to_rho.py; standard DT sign convention.
// ===========================================================================

// Perko A 10_161: DT [4, 12, -16, 14, -18, 2, 8, -20, -10, -6]  (n=10, 20 arcs)
new Gate, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10,
    a11, a12, a13, a14, a15, a16, a17, a18, a19, a20 in {

  contract Gate(oi, oo, ui, uo) = {
    new l in {
        for (s <- oi)          { oo!(*s) | l!(Nil) }
      | for (s <- ui & _ <- l) { uo!(*s) | Gate!(*oi, *oo, *ui, *uo) }
    }
  }
  |
  Gate!(*a20, *a1,  *a3,  *a4)    // crossing  1: over a20->a1,  under a3->a4
  | Gate!(*a2,  *a3,  *a11, *a12)   // crossing  2: over a2->a3,   under a11->a12
  | Gate!(*a15, *a16, *a4,  *a5)    // crossing  3: over a15->a16, under a4->a5
  | Gate!(*a6,  *a7,  *a13, *a14)   // crossing  4: over a6->a7,   under a13->a14
  | Gate!(*a17, *a18, *a8,  *a9)    // crossing  5: over a17->a18, under a8->a9
  | Gate!(*a10, *a11, *a1,  *a2)    // crossing  6: over a10->a11, under a1->a2
  | Gate!(*a12, *a13, *a7,  *a8)    // crossing  7: over a12->a13, under a7->a8
  | Gate!(*a19, *a20, *a14, *a15)   // crossing  8: over a19->a20, under a14->a15
  | Gate!(*a9,  *a10, *a16, *a17)   // crossing  9: over a9->a10,  under a16->a17
  | Gate!(*a5,  *a6,  *a18, *a19)   // crossing 10: over a5->a6,   under a18->a19
  |
  // current: one token per arc; conserved, period 20
  a1!(Nil)  | a2!(Nil)  | a3!(Nil)  | a4!(Nil)  | a5!(Nil)  | a6!(Nil)  | a7!(Nil)  |
  a8!(Nil)  | a9!(Nil)  | a10!(Nil) | a11!(Nil) | a12!(Nil) | a13!(Nil) | a14!(Nil) |
  a15!(Nil) | a16!(Nil) | a17!(Nil) | a18!(Nil) | a19!(Nil) | a20!(Nil)
}
